generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Auth & Role
model User {
  id         Int        @id @default(autoincrement())
  username   String     @unique @db.VarChar(50)
  email      String     @unique @db.VarChar(150)
  password   String     @db.VarChar(255)
  fullName   String     @map("full_name") @db.VarChar(150)
  isActive   Boolean    @default(true) @map("is_active")
  employeeId Int?       @unique @map("employee_id")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  userRoles  UserRole[]

  equipmentStatusLogs   EquipmentStatusLog[]
  equipmentWorkhourLogs EquipmentWorkhourLog[]
  maintenanceRecords    MaintenanceRecord[]
  damageLogsReported    DamageLog[]            @relation("DamageReportedBy")
  damageLogsReviewed    DamageLog[]            @relation("DamageReviewedBy")

  purchaseRequestsCreated         EquipmentPurchaseRequest[] @relation("PrRequestedBy")
  purchaseRequestsAdminValidated  EquipmentPurchaseRequest[] @relation("PrAdminValidatedBy")
  purchaseRequestsFinanceApproved EquipmentPurchaseRequest[] @relation("PrFinanceApprovedBy")
  purchaseRequestsCancelled       EquipmentPurchaseRequest[] @relation("PrCancelledBy")

  cashTransactionsCreated EquipmentCashTransaction[] @relation("CashCreatedBy")
  cashTransactionsVoided  EquipmentCashTransaction[] @relation("CashVoidedBy")

  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?          @db.Text
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id     Int              @id @default(autoincrement())
  module String           @db.VarChar(50)
  action String           @db.VarChar(50)
  label  String           @db.VarChar(150)
  roles  RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  roleId Int  @map("role_id")
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// DIVISI ALAT — Batch 1: Master Alat & Workhour
// ============================================================

/// KONDISI unit alat — bukan lokasi atau penugasannya.
/// Mekanik datang ke alat (tidak ditarik ke bengkel), jadi alat yang diperbaiki
/// tetap terikat alokasi proyeknya. Pertanyaan "alat ini di mana dan ditugaskan
/// ke proyek apa" dijawab sub_project_equipment_allocations pada modul Project,
/// dan disajikan API sebagai field turunan `assignment` — bukan kolom di sini.
/// `maintenance` mencakup rusak, perbaikan, dan perawatan; penyebabnya dibedakan
/// lewat equipment_status_logs.source_type (damage_log vs maintenance_record).
enum EquipmentItemStatus {
  operational
  maintenance
  retired

  @@map("equipment_item_status")
}

enum WorkhourSourceType {
  internal_project
  external_rental
  manual_adjustment

  @@map("workhour_source_type")
}

model EquipmentType {
  id           Int             @id @default(autoincrement())
  typeCode     String          @unique @map("type_code") @db.VarChar(50)
  typeName     String          @map("type_name") @db.VarChar(150)
  description  String?         @db.Text
  isActive     Boolean         @default(true) @map("is_active")
  // Counter asset code per jenis alat. Di-increment atomik saat unit baru
  // didaftarkan dan tidak pernah mundur, supaya nomor tidak pernah dipakai ulang.
  lastSequence Int             @default(0) @map("last_sequence")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  items        EquipmentItem[]

  @@map("equipment_types")
}

model EquipmentItem {
  id                Int                 @id @default(autoincrement())
  equipmentTypeId   Int                 @map("equipment_type_id")
  assetCode         String              @unique @map("asset_code") @db.VarChar(50)
  plateNumber       String?             @map("plate_number") @db.VarChar(30)
  brand             String?             @db.VarChar(100)
  model             String?             @db.VarChar(100)
  serialNumber      String?             @map("serial_number") @db.VarChar(100)
  manufactureYear   Int?                @map("manufacture_year")
  currentStatus     EquipmentItemStatus @default(operational) @map("current_status")
  // Akumulator jam kerja, ditambah oleh service saat workhour log dibuat
  totalWorkhour     Decimal             @default(0) @map("total_workhour") @db.Decimal(12, 2)
  // Default rate income alat; modul Income tetap memakai rate_snapshot sendiri
  defaultHourlyRate Decimal?            @map("default_hourly_rate") @db.Decimal(18, 2)
  rateNotes         String?             @map("rate_notes") @db.Text
  rateUpdatedAt     DateTime?           @map("rate_updated_at")
  notes             String?             @db.Text
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  equipmentType       EquipmentType                 @relation(fields: [equipmentTypeId], references: [id])
  statusLogs          EquipmentStatusLog[]
  workhourLogs        EquipmentWorkhourLog[]
  maintenanceSettings EquipmentMaintenanceSetting[]
  maintenanceRecords  MaintenanceRecord[]
  damageLogs          DamageLog[]

  @@index([equipmentTypeId])
  @@index([currentStatus])
  @@map("equipment_items")
}

model EquipmentStatusLog {
  id              Int                  @id @default(autoincrement())
  equipmentItemId Int                  @map("equipment_item_id")
  oldStatus       EquipmentItemStatus? @map("old_status")
  newStatus       EquipmentItemStatus  @map("new_status")
  // equipment_request | workhour | maintenance_record | damage_log | manual
  sourceType      String?              @map("source_type") @db.VarChar(80)
  sourceId        Int?                 @map("source_id")
  notes           String?              @db.Text
  changedBy       Int?                 @map("changed_by")
  changedAt       DateTime             @default(now()) @map("changed_at")

  equipmentItem EquipmentItem @relation(fields: [equipmentItemId], references: [id])
  changedByUser User?         @relation(fields: [changedBy], references: [id])

  @@index([equipmentItemId, changedAt])
  @@map("equipment_status_logs")
}

model EquipmentWorkhourLog {
  id              Int                @id @default(autoincrement())
  equipmentItemId Int                @map("equipment_item_id")
  // FK ke projects/sub_projects menyusul saat modul Project dibangun
  projectId       Int?               @map("project_id")
  subProjectId    Int?               @map("sub_project_id")
  workDate        DateTime           @map("work_date") @db.Date
  startedAt       DateTime?          @map("started_at")
  stoppedAt       DateTime?          @map("stopped_at")
  totalWorkhour   Decimal            @map("total_workhour") @db.Decimal(10, 2)
  sourceType      WorkhourSourceType @map("source_type")
  description     String?            @db.Text
  createdBy       Int?               @map("created_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  equipmentItem EquipmentItem @relation(fields: [equipmentItemId], references: [id])
  createdByUser User?         @relation(fields: [createdBy], references: [id])

  @@index([equipmentItemId, workDate])
  @@index([workDate])
  @@map("equipment_workhour_logs")
}

// ============================================================
// DIVISI ALAT — Batch 2: Maintenance
// ============================================================

enum MaintenanceSettingStatus {
  normal
  warning
  due
  overdue
  inactive

  @@map("maintenance_setting_status")
}

enum MaintenanceType {
  routine
  repair
  replacement
  inspection
  adjustment

  @@map("maintenance_type")
}

enum MaintenanceRecordStatus {
  completed
  cancelled

  @@map("maintenance_record_status")
}

/// Master aspek maintenance: oli mesin, filter udara, ban, servis berkala, dst.
model MaintenanceAspect {
  id                    Int      @id @default(autoincrement())
  aspectCode            String   @unique @map("aspect_code") @db.VarChar(50)
  aspectName            String   @map("aspect_name") @db.VarChar(150)
  // Semua threshold maintenance berbasis JAM KERJA alat, digerakkan workhour log.
  defaultThresholdValue Decimal? @map("default_threshold_value") @db.Decimal(12, 2)
  // Sisa jam saat peringatan mulai muncul. Default 50 -> warning saat sisa 50 jam.
  warningLeadValue      Decimal  @default(50) @map("warning_lead_value") @db.Decimal(12, 2)
  description           String?  @db.Text
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  settings EquipmentMaintenanceSetting[]

  @@map("maintenance_aspects")
}

/// Setting maintenance per unit alat per aspek, lengkap dengan counter berjalan.
model EquipmentMaintenanceSetting {
  id                     Int                      @id @default(autoincrement())
  equipmentItemId        Int                      @map("equipment_item_id")
  maintenanceAspectId    Int                      @map("maintenance_aspect_id")
  thresholdValue         Decimal                  @map("threshold_value") @db.Decimal(12, 2)
  // Jam terpakai sejak servis terakhir. Ditambah otomatis oleh workhour log.
  currentValueSinceReset Decimal                  @default(0) @map("current_value_since_reset") @db.Decimal(12, 2)
  status                 MaintenanceSettingStatus @default(normal)
  lastMaintenanceDate    DateTime?                @map("last_maintenance_date") @db.Date
  lastResetWorkhour      Decimal?                 @map("last_reset_workhour") @db.Decimal(12, 2)
  isActive               Boolean                  @default(true) @map("is_active")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  equipmentItem            EquipmentItem                      @relation(fields: [equipmentItemId], references: [id])
  maintenanceAspect        MaintenanceAspect                  @relation(fields: [maintenanceAspectId], references: [id])
  maintenanceRecords       MaintenanceRecord[]
  purchaseMaintenanceItems EquipmentPurchaseMaintenanceItem[]

  @@unique([equipmentItemId, maintenanceAspectId])
  @@index([status])
  @@map("equipment_maintenance_settings")
}

/// Histori tindakan maintenance. Dibuat setelah pekerjaan selesai.
model MaintenanceRecord {
  id                    Int                     @id @default(autoincrement())
  maintenanceCode       String                  @unique @map("maintenance_code") @db.VarChar(50)
  // Selalu terisi, supaya riwayat per alat tetap utuh walau record lahir dari
  // damage log atau purchase request yang tidak punya maintenance setting.
  equipmentItemId       Int                     @map("equipment_item_id")
  maintenanceSettingId  Int?                    @map("maintenance_setting_id")
  damageLogId           Int?                    @map("damage_log_id")
  // Menunjuk header PR, bukan baris item. Baris spesifiknya ditelusuri lewat
  // damageLogId / maintenanceSettingId yang sama pada tabel item PR.
  purchaseRequestId     Int?                    @map("purchase_request_id")
  maintenanceType       MaintenanceType         @map("maintenance_type")
  maintenanceDate       DateTime                @map("maintenance_date") @db.Date
  workhourAtMaintenance Decimal?                @map("workhour_at_maintenance") @db.Decimal(12, 2)
  actionDescription     String                  @map("action_description") @db.Text
  performedBy           String?                 @map("performed_by") @db.VarChar(150)
  status                MaintenanceRecordStatus @default(completed)
  createdBy             Int?                    @map("created_by")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  equipmentItem      EquipmentItem                @relation(fields: [equipmentItemId], references: [id])
  maintenanceSetting EquipmentMaintenanceSetting? @relation(fields: [maintenanceSettingId], references: [id])
  damageLog          DamageLog?                   @relation(fields: [damageLogId], references: [id])
  purchaseRequest    EquipmentPurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  createdByUser      User?                        @relation(fields: [createdBy], references: [id])

  @@index([equipmentItemId, maintenanceDate])
  @@index([maintenanceSettingId, maintenanceDate])
  @@index([maintenanceDate])
  @@map("maintenance_records")
}

/// Counter nomor dokumen per jenis dokumen per periode.
/// MTN memakai period 'ALL' (deret berurutan terus, tanpa reset bulanan).
/// Kolom period disiapkan untuk dokumen lain yang nanti butuh reset periodik.
model DocumentSequence {
  id           Int      @id @default(autoincrement())
  docType      String   @map("doc_type") @db.VarChar(20)
  period       String   @db.VarChar(10)
  lastSequence Int      @default(0) @map("last_sequence")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([docType, period])
  @@map("document_sequences")
}

// ============================================================
// DIVISI ALAT — Batch 3: Damage Logs
// ============================================================

/// reported = ada masalah yang belum beres. resolved = sudah selesai ditangani.
/// Tidak ada status "sedang dikerjakan": Divisi Alat sendiri yang mencatat dan
/// mengerjakan, jadi tahapan itu tidak mengubah keputusan siapa pun. Kalau nanti
/// diperlukan, menambah nilai enum di PostgreSQL murah.
enum DamageStatus {
  reported
  resolved
  cancelled

  @@map("damage_status")
}

/// Sparepart diambil dari stok gudang sendiri, atau harus dibeli ke supplier
/// (yang berarti butuh Purchase Request lebih dulu).
enum SparePartSource {
  warehouse
  supplier

  @@map("spare_part_source")
}

/// Mekanik internal Divisi Alat, atau bengkel/teknisi luar yang dipanggil.
/// Mekanik selalu didatangkan ke alat, alat tidak ditarik ke bengkel.
enum MechanicTeam {
  internal
  external

  @@map("mechanic_team")
}

/// Laporan kerusakan alat, dicatat dan dikelola sendiri oleh Divisi Alat.
/// Tanpa kolom tingkat keparahan — lihat docs/keputusan-desain-divisi-alat.md.
model DamageLog {
  id              Int          @id @default(autoincrement())
  damageCode      String       @unique @map("damage_code") @db.VarChar(50)
  equipmentItemId Int          @map("equipment_item_id")
  // Mewarisi utang desain yang sama dengan equipment_workhour_logs:
  // FK menyusul saat modul Project dibangun.
  projectId       Int?         @map("project_id")
  subProjectId    Int?         @map("sub_project_id")
  // Tanggal KEJADIAN, bukan tanggal input. Dibedakan karena laporan masuk lewat
  // telepon ke Divisi Alat, sering baru diketik beberapa jam atau hari kemudian.
  damageDate      DateTime     @map("damage_date") @db.Date
  status          DamageStatus @default(reported)
  description     String       @db.Text

  /// Pernyataan laporan ini bahwa alat tidak bisa dioperasikan. Kalau true,
  /// equipment_items.current_status ikut jadi `maintenance` saat laporan dibuat.
  /// Dipakai juga untuk memastikan alat tidak dibebaskan saat satu laporan
  /// selesai sementara laporan lain yang menghentikannya masih terbuka.
  stopsOperation Boolean @default(false) @map("stops_operation")

  // Keputusan penanganan. Nullable di database supaya saat Lapangan nanti boleh
  // melapor sendiri (mereka tidak tahu jawabannya) cukup melonggarkan validator,
  // tanpa migrasi struktur. Hari ini tetap WAJIB lewat validasi API.
  sparePartSource SparePartSource? @map("spare_part_source")
  mechanicTeam    MechanicTeam?    @map("mechanic_team")

  // User Divisi Alat yang mengetik laporan. Bukan operator lapangan yang melihat
  // kejadiannya — jejak itu baru ada saat Lapangan boleh melapor lewat sistem.
  reportedBy Int? @map("reported_by")

  // Belum dipakai UI mana pun. Disiapkan untuk saat Lapangan boleh melapor
  // sendiri, sehingga muncul langkah pemeriksaan oleh Divisi Alat.
  reviewedBy Int?      @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")

  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  equipmentItem       EquipmentItem                 @relation(fields: [equipmentItemId], references: [id])
  reportedByUser      User?                         @relation("DamageReportedBy", fields: [reportedBy], references: [id])
  reviewedByUser      User?                         @relation("DamageReviewedBy", fields: [reviewedBy], references: [id])
  maintenanceRecords  MaintenanceRecord[]
  purchaseRepairItems EquipmentPurchaseRepairItem[]

  @@index([equipmentItemId, damageDate])
  @@index([status])
  @@map("damage_logs")
}

// ============================================================
// DIVISI ALAT — Batch 4: Purchase Request
// ============================================================

/// Kategori order menentukan tabel item mana yang sah untuk satu pengajuan.
/// Disimpan sebagai enum, BUKAN FK ke equipment_cash_category, karena kategori
/// kas adalah tabel master yang boleh diubah Divisi Alat — sedangkan jumlah
/// tabel item adalah struktur skema yang tetap. Kategori kas diturunkan dari
/// nilai ini lewat equipment_cash_category.order_category (dibangun di Batch 5).
enum PurchaseOrderCategory {
  repair
  maintenance
  stock

  @@map("purchase_order_category")
}

/// `admin_validated` dari ERD DIBUANG (27 Sep 2026): ERD Approval Center
/// memetakan validate_by_admin langsung ke waiting_finance_approval, jadi status
/// itu tidak pernah mengendap. Siapa yang memvalidasi dan kapan sudah terekam
/// kolom admin_validated_by/_at — argumen yang sama dipakai saat membuang
/// `reviewed` dari damage_status.
enum PurchaseRequestStatus {
  submitted
  rejected_by_admin
  waiting_finance_approval
  rejected_by_finance
  approved
  cancelled

  @@map("purchase_request_status")
}

/// Header pengajuan pembelian Divisi Alat. Jadi sumber cash-out Kas Alat
/// (source_type = equipment_purchase_request) dan approval_tasks di Approval Center.
model EquipmentPurchaseRequest {
  id            Int                   @id @default(autoincrement())
  requestCode   String                @unique @map("request_code") @db.VarChar(50)
  requestDate   DateTime              @map("request_date") @db.Date
  // Tidak boleh diubah setelah dibuat — item yang sudah menempel akan jadi yatim
  orderCategory PurchaseOrderCategory @map("order_category")
  status        PurchaseRequestStatus @default(submitted)

  // Dihitung sistem dari item, bukan dari kiriman klien
  totalEstimatedAmount Decimal  @default(0) @map("total_estimated_amount") @db.Decimal(18, 2)
  // Nominal AKTUAL yang dicairkan Finance. INI yang dipakai sebagai amount
  // cash-out Kas Alat — bukan totalEstimatedAmount.
  totalApprovedAmount  Decimal? @map("total_approved_amount") @db.Decimal(18, 2)

  requestedBy       Int       @map("requested_by")
  adminValidatedBy  Int?      @map("admin_validated_by")
  adminValidatedAt  DateTime? @map("admin_validated_at")
  financeApprovedBy Int?      @map("finance_approved_by")
  financeApprovedAt DateTime? @map("finance_approved_at")
  cancelledBy       Int?      @map("cancelled_by")
  cancelledAt       DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  requestedByUser       User  @relation("PrRequestedBy", fields: [requestedBy], references: [id])
  adminValidatedByUser  User? @relation("PrAdminValidatedBy", fields: [adminValidatedBy], references: [id])
  financeApprovedByUser User? @relation("PrFinanceApprovedBy", fields: [financeApprovedBy], references: [id])
  cancelledByUser       User? @relation("PrCancelledBy", fields: [cancelledBy], references: [id])

  repairItems        EquipmentPurchaseRepairItem[]
  maintenanceItems   EquipmentPurchaseMaintenanceItem[]
  stockItems         EquipmentPurchaseStockItem[]
  maintenanceRecords MaintenanceRecord[]

  // Target composite FK dari tabel item — inilah yang membuat baris item
  // tidak mungkin menempel ke header berkategori lain
  @@unique([id, orderCategory])
  @@index([orderCategory, status])
  @@index([requestDate])
  @@map("equipment_purchase_requests")
}

/// Satu baris per kerusakan yang ditangani. Satu order boleh mencakup beberapa
/// kerusakan. Unit alat dan uraian kerusakan dibaca dari damage_logs.
model EquipmentPurchaseRepairItem {
  id                 Int                   @id @default(autoincrement())
  purchaseRequestId  Int                   @map("purchase_request_id")
  orderCategory      PurchaseOrderCategory @default(repair) @map("order_category")
  damageLogId        Int                   @map("damage_log_id")
  // 0 kalau dikerjakan mekanik internal
  serviceFee         Decimal               @default(0) @map("service_fee") @db.Decimal(18, 2)
  approvedServiceFee Decimal?              @map("approved_service_fee") @db.Decimal(18, 2)
  notes              String?               @db.Text

  purchaseRequest EquipmentPurchaseRequest           @relation(fields: [purchaseRequestId, orderCategory], references: [id, orderCategory], onDelete: Cascade)
  damageLog       DamageLog                          @relation(fields: [damageLogId], references: [id])
  spareparts      EquipmentPurchaseRepairSparepart[]

  @@unique([purchaseRequestId, damageLogId])
  @@index([damageLogId])
  @@map("equipment_purchase_repair_items")
}

/// Sparepart yang dibeli untuk satu kerusakan. Induknya sudah terikat kategori
/// repair, jadi tidak perlu composite FK lagi di sini.
model EquipmentPurchaseRepairSparepart {
  id                  Int      @id @default(autoincrement())
  repairItemId        Int      @map("repair_item_id")
  itemName            String   @map("item_name") @db.VarChar(200)
  quantity            Decimal  @default(1) @db.Decimal(18, 2)
  estimatedUnitPrice  Decimal  @map("estimated_unit_price") @db.Decimal(18, 2)
  estimatedTotalPrice Decimal  @map("estimated_total_price") @db.Decimal(18, 2)
  approvedTotalPrice  Decimal? @map("approved_total_price") @db.Decimal(18, 2)

  repairItem EquipmentPurchaseRepairItem @relation(fields: [repairItemId], references: [id], onDelete: Cascade)

  @@index([repairItemId])
  @@map("equipment_purchase_repair_spareparts")
}

/// Satu baris per aspek maintenance pada satu unit. maintenanceSettingId sudah
/// memuat dua input form sekaligus (unit alat + aspek), jadi tidak disimpan ulang.
model EquipmentPurchaseMaintenanceItem {
  id                   Int                   @id @default(autoincrement())
  purchaseRequestId    Int                   @map("purchase_request_id")
  orderCategory        PurchaseOrderCategory @default(maintenance) @map("order_category")
  maintenanceSettingId Int                   @map("maintenance_setting_id")
  estimatedPrice       Decimal               @map("estimated_price") @db.Decimal(18, 2)
  approvedPrice        Decimal?              @map("approved_price") @db.Decimal(18, 2)

  purchaseRequest    EquipmentPurchaseRequest    @relation(fields: [purchaseRequestId, orderCategory], references: [id, orderCategory], onDelete: Cascade)
  maintenanceSetting EquipmentMaintenanceSetting @relation(fields: [maintenanceSettingId], references: [id])

  @@unique([purchaseRequestId, maintenanceSettingId])
  @@index([maintenanceSettingId])
  @@map("equipment_purchase_maintenance_items")
}

/// Pembelian stok gudang — mencakup semua jenis barang (sparepart, oli, grease,
/// majun), tidak dipilah jenisnya. Tanpa satuan, mengikuti form.
model EquipmentPurchaseStockItem {
  id                  Int                   @id @default(autoincrement())
  purchaseRequestId   Int                   @map("purchase_request_id")
  orderCategory       PurchaseOrderCategory @default(stock) @map("order_category")
  itemName            String                @map("item_name") @db.VarChar(200)
  quantity            Decimal               @db.Decimal(18, 2)
  estimatedUnitPrice  Decimal               @map("estimated_unit_price") @db.Decimal(18, 2)
  estimatedTotalPrice Decimal               @map("estimated_total_price") @db.Decimal(18, 2)
  approvedTotalPrice  Decimal?              @map("approved_total_price") @db.Decimal(18, 2)

  purchaseRequest EquipmentPurchaseRequest @relation(fields: [purchaseRequestId, orderCategory], references: [id, orderCategory], onDelete: Cascade)

  @@index([purchaseRequestId])
  @@map("equipment_purchase_stock_items")
}

// ============================================================
// DIVISI ALAT — Batch 5: Kas Alat
// ============================================================

enum CashTransactionType {
  cash_in
  cash_out

  @@map("cash_transaction_type")
}

/// Dari mana baris kas ini lahir.
/// `opening_balance`, `manual_expense`, dan `adjustment` diketik manusia.
/// `equipment_purchase_request` dan `equipment_income_claim` WAJIB dibuat sistem —
/// kalau boleh diketik manual, orang bisa mencatat cash-in klaim fiktif tanpa
/// klaim di belakangnya.
enum CashTransactionSourceType {
  opening_balance
  equipment_income_claim
  equipment_purchase_request
  manual_expense
  adjustment

  @@map("cash_transaction_source_type")
}

/// Master kategori kas, dikelola sendiri oleh Divisi Alat.
model EquipmentCashCategory {
  id              Int                 @id @default(autoincrement())
  categoryName    String              @map("category_name") @db.VarChar(150)
  transactionType CashTransactionType @map("transaction_type")

  /// Memetakan kategori ORDER pada purchase request (repair/maintenance/stock)
  /// ke kategori kas ini. Saat Finance menyetujui order, cash-out-nya memakai
  /// kategori hasil pemetaan ini — tidak dipilih manual, jadi tidak bisa
  /// bertentangan dengan isi ordernya.
  /// NULL untuk kategori yang tidak berasal dari order: seluruh cash-in,
  /// koreksi, dan operasional divisi.
  /// Unique supaya satu kategori order tidak menunjuk dua kategori kas.
  orderCategory PurchaseOrderCategory? @unique @map("order_category")

  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  transactions EquipmentCashTransaction[]

  @@unique([categoryName, transactionType])
  @@map("equipment_cash_category")
}

/// Catatan uang masuk dan keluar Kas Alat.
///
/// Saldo TIDAK disimpan per baris, melainkan dihitung saat dibaca:
/// SUM(cash_in) - SUM(cash_out) atas baris yang tidak dibatalkan. Konsekuensinya
/// baris manual boleh diperbaiki dan dibatalkan tanpa merusak apa pun — beda
/// dengan buku besar yang menyimpan saldo berjalan, di mana satu perubahan di
/// tengah membuat saldo seluruh baris sesudahnya salah.
///
/// Volume kas divisi ini ratusan baris per tahun, jadi menjumlahkannya saat
/// dibaca tidak terasa, dan sebagai gantinya tidak perlu penguncian baris
/// maupun koreksi lewat baris lawan.
model EquipmentCashTransaction {
  id              Int                       @id @default(autoincrement())
  transactionCode String                    @unique @map("transaction_code") @db.VarChar(50)
  transactionDate DateTime                  @map("transaction_date") @db.Date
  transactionType CashTransactionType       @map("transaction_type")
  categoryId      Int                       @map("category_id")
  amount          Decimal                   @db.Decimal(18, 2)
  sourceType      CashTransactionSourceType @map("source_type")

  /// Id dokumen sumber — referensi logis, bukan FK, karena tabel tujuannya
  /// berbeda per sourceType (dan equipment_income_claim belum ada).
  sourceId Int? @map("source_id")

  description String @db.Text

  /// Pembatalan tidak menghapus barisnya, supaya kalau ada yang bertanya
  /// "kok catatan ini hilang" jejaknya masih ada beserta alasannya.
  /// Baris yang dibatalkan tidak ikut dihitung ke saldo.
  /// Boolean, bukan enum status — hanya ada dua keadaan, sama seperti
  /// keputusan memakai `stops_operation` untuk damage log.
  isVoided   Boolean   @default(false) @map("is_voided")
  voidReason String?   @map("void_reason") @db.Text
  voidedBy   Int?      @map("voided_by")
  voidedAt   DateTime? @map("voided_at")

  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category      EquipmentCashCategory @relation(fields: [categoryId], references: [id])
  createdByUser User?                 @relation("CashCreatedBy", fields: [createdBy], references: [id])
  voidedByUser  User?                 @relation("CashVoidedBy", fields: [voidedBy], references: [id])

  @@index([transactionDate])
  @@index([sourceType, sourceId])
  @@index([categoryId])
  @@index([isVoided])
  @@map("equipment_cash_transaction")
}
