generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Auth & Role
model User {
  id         Int        @id @default(autoincrement())
  username   String     @unique @db.VarChar(50)
  email      String     @unique @db.VarChar(150)
  password   String     @db.VarChar(255)
  fullName   String     @map("full_name") @db.VarChar(150)
  isActive   Boolean    @default(true) @map("is_active")
  employeeId Int?       @unique @map("employee_id")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  userRoles  UserRole[]

  equipmentStatusLogs   EquipmentStatusLog[]
  equipmentWorkhourLogs EquipmentWorkhourLog[]
  maintenanceRecords    MaintenanceRecord[]

  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?          @db.Text
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id     Int              @id @default(autoincrement())
  module String           @db.VarChar(50)
  action String           @db.VarChar(50)
  label  String           @db.VarChar(150)
  roles  RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  roleId Int  @map("role_id")
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// DIVISI ALAT — Batch 1: Master Alat & Workhour
// ============================================================

enum EquipmentItemStatus {
  available
  assigned
  delivered_to_location
  received_at_site
  in_use
  maintenance
  damaged
  retired

  @@map("equipment_item_status")
}

enum WorkhourSourceType {
  internal_project
  external_rental
  manual_adjustment

  @@map("workhour_source_type")
}

model EquipmentType {
  id           Int             @id @default(autoincrement())
  typeCode     String          @unique @map("type_code") @db.VarChar(50)
  typeName     String          @map("type_name") @db.VarChar(150)
  description  String?         @db.Text
  isActive     Boolean         @default(true) @map("is_active")
  // Counter asset code per jenis alat. Di-increment atomik saat unit baru
  // didaftarkan dan tidak pernah mundur, supaya nomor tidak pernah dipakai ulang.
  lastSequence Int             @default(0) @map("last_sequence")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  items        EquipmentItem[]

  @@map("equipment_types")
}

model EquipmentItem {
  id                Int                 @id @default(autoincrement())
  equipmentTypeId   Int                 @map("equipment_type_id")
  assetCode         String              @unique @map("asset_code") @db.VarChar(50)
  plateNumber       String?             @map("plate_number") @db.VarChar(30)
  brand             String?             @db.VarChar(100)
  model             String?             @db.VarChar(100)
  serialNumber      String?             @map("serial_number") @db.VarChar(100)
  manufactureYear   Int?                @map("manufacture_year")
  currentStatus     EquipmentItemStatus @default(available) @map("current_status")
  // Akumulator jam kerja, ditambah oleh service saat workhour log dibuat
  totalWorkhour     Decimal             @default(0) @map("total_workhour") @db.Decimal(12, 2)
  // Default rate income alat; modul Income tetap memakai rate_snapshot sendiri
  defaultHourlyRate Decimal?            @map("default_hourly_rate") @db.Decimal(18, 2)
  rateNotes         String?             @map("rate_notes") @db.Text
  rateUpdatedAt     DateTime?           @map("rate_updated_at")
  notes             String?             @db.Text
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  equipmentType       EquipmentType                 @relation(fields: [equipmentTypeId], references: [id])
  statusLogs          EquipmentStatusLog[]
  workhourLogs        EquipmentWorkhourLog[]
  maintenanceSettings EquipmentMaintenanceSetting[]
  maintenanceRecords  MaintenanceRecord[]

  @@index([equipmentTypeId])
  @@index([currentStatus])
  @@map("equipment_items")
}

model EquipmentStatusLog {
  id              Int                  @id @default(autoincrement())
  equipmentItemId Int                  @map("equipment_item_id")
  oldStatus       EquipmentItemStatus? @map("old_status")
  newStatus       EquipmentItemStatus  @map("new_status")
  // equipment_request | workhour | maintenance_record | damage_log | manual
  sourceType      String?              @map("source_type") @db.VarChar(80)
  sourceId        Int?                 @map("source_id")
  notes           String?              @db.Text
  changedBy       Int?                 @map("changed_by")
  changedAt       DateTime             @default(now()) @map("changed_at")

  equipmentItem EquipmentItem @relation(fields: [equipmentItemId], references: [id])
  changedByUser User?         @relation(fields: [changedBy], references: [id])

  @@index([equipmentItemId, changedAt])
  @@map("equipment_status_logs")
}

model EquipmentWorkhourLog {
  id              Int                @id @default(autoincrement())
  equipmentItemId Int                @map("equipment_item_id")
  // FK ke projects/sub_projects menyusul saat modul Project dibangun
  projectId       Int?               @map("project_id")
  subProjectId    Int?               @map("sub_project_id")
  workDate        DateTime           @map("work_date") @db.Date
  startedAt       DateTime?          @map("started_at")
  stoppedAt       DateTime?          @map("stopped_at")
  totalWorkhour   Decimal            @map("total_workhour") @db.Decimal(10, 2)
  sourceType      WorkhourSourceType @map("source_type")
  description     String?            @db.Text
  createdBy       Int?               @map("created_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  equipmentItem EquipmentItem @relation(fields: [equipmentItemId], references: [id])
  createdByUser User?         @relation(fields: [createdBy], references: [id])

  @@index([equipmentItemId, workDate])
  @@index([workDate])
  @@map("equipment_workhour_logs")
}

// ============================================================
// DIVISI ALAT — Batch 2: Maintenance
// ============================================================

enum MaintenanceSettingStatus {
  normal
  warning
  due
  overdue
  inactive

  @@map("maintenance_setting_status")
}

enum MaintenanceType {
  routine
  repair
  replacement
  inspection
  adjustment

  @@map("maintenance_type")
}

enum MaintenanceRecordStatus {
  completed
  cancelled

  @@map("maintenance_record_status")
}

/// Master aspek maintenance: oli mesin, filter udara, ban, servis berkala, dst.
model MaintenanceAspect {
  id                    Int      @id @default(autoincrement())
  aspectCode            String   @unique @map("aspect_code") @db.VarChar(50)
  aspectName            String   @map("aspect_name") @db.VarChar(150)
  // Semua threshold maintenance berbasis JAM KERJA alat, digerakkan workhour log.
  defaultThresholdValue Decimal? @map("default_threshold_value") @db.Decimal(12, 2)
  // Sisa jam saat peringatan mulai muncul. Default 50 -> warning saat sisa 50 jam.
  warningLeadValue      Decimal  @default(50) @map("warning_lead_value") @db.Decimal(12, 2)
  description           String?  @db.Text
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  settings EquipmentMaintenanceSetting[]

  @@map("maintenance_aspects")
}

/// Setting maintenance per unit alat per aspek, lengkap dengan counter berjalan.
model EquipmentMaintenanceSetting {
  id                     Int                      @id @default(autoincrement())
  equipmentItemId        Int                      @map("equipment_item_id")
  maintenanceAspectId    Int                      @map("maintenance_aspect_id")
  thresholdValue         Decimal                  @map("threshold_value") @db.Decimal(12, 2)
  // Jam terpakai sejak servis terakhir. Ditambah otomatis oleh workhour log.
  currentValueSinceReset Decimal                  @default(0) @map("current_value_since_reset") @db.Decimal(12, 2)
  status                 MaintenanceSettingStatus @default(normal)
  lastMaintenanceDate    DateTime?                @map("last_maintenance_date") @db.Date
  lastResetWorkhour      Decimal?                 @map("last_reset_workhour") @db.Decimal(12, 2)
  isActive               Boolean                  @default(true) @map("is_active")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  equipmentItem      EquipmentItem       @relation(fields: [equipmentItemId], references: [id])
  maintenanceAspect  MaintenanceAspect   @relation(fields: [maintenanceAspectId], references: [id])
  maintenanceRecords MaintenanceRecord[]

  @@unique([equipmentItemId, maintenanceAspectId])
  @@index([status])
  @@map("equipment_maintenance_settings")
}

/// Histori tindakan maintenance. Dibuat setelah pekerjaan selesai.
model MaintenanceRecord {
  id                    Int                     @id @default(autoincrement())
  maintenanceCode       String                  @unique @map("maintenance_code") @db.VarChar(50)
  // Selalu terisi, supaya riwayat per alat tetap utuh walau record lahir dari
  // damage log atau purchase request yang tidak punya maintenance setting.
  equipmentItemId       Int                     @map("equipment_item_id")
  maintenanceSettingId  Int?                    @map("maintenance_setting_id")
  // FK menyusul saat modul Damage Log dan Purchase Request dibangun
  damageLogId           Int?                    @map("damage_log_id")
  purchaseRequestItemId Int?                    @map("purchase_request_item_id")
  maintenanceType       MaintenanceType         @map("maintenance_type")
  maintenanceDate       DateTime                @map("maintenance_date") @db.Date
  workhourAtMaintenance Decimal?                @map("workhour_at_maintenance") @db.Decimal(12, 2)
  actionDescription     String                  @map("action_description") @db.Text
  performedBy           String?                 @map("performed_by") @db.VarChar(150)
  status                MaintenanceRecordStatus @default(completed)
  createdBy             Int?                    @map("created_by")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  equipmentItem      EquipmentItem                @relation(fields: [equipmentItemId], references: [id])
  maintenanceSetting EquipmentMaintenanceSetting? @relation(fields: [maintenanceSettingId], references: [id])
  createdByUser      User?                        @relation(fields: [createdBy], references: [id])

  @@index([equipmentItemId, maintenanceDate])
  @@index([maintenanceSettingId, maintenanceDate])
  @@index([maintenanceDate])
  @@map("maintenance_records")
}

/// Counter nomor dokumen per jenis dokumen per periode.
/// MTN memakai period 'ALL' (deret berurutan terus, tanpa reset bulanan).
/// Kolom period disiapkan untuk dokumen lain yang nanti butuh reset periodik.
model DocumentSequence {
  id           Int      @id @default(autoincrement())
  docType      String   @map("doc_type") @db.VarChar(20)
  period       String   @db.VarChar(10)
  lastSequence Int      @default(0) @map("last_sequence")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([docType, period])
  @@map("document_sequences")
}
